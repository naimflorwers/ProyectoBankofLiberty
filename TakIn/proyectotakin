server {
    listen 80;
    server_name penyrphf.icu www.penyrphf.icu;

    root /var/www/ProyectoBankofLiberty/TakIn/dist/ProyectoBanco/browser;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://34.206.61.175:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    access_log /var/log/nginx/proyectobanco-access.log;
    error_log /var/log/nginx/proyectobanco-error.log;
}
